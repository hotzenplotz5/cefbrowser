#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

include /usr/share/dpkg/architecture.mk

BUILDDIR := obj-$(DEB_HOST_GNU_TYPE)

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	test -d subprojects/cef/Release
	test -d subprojects/cef/Resources
	test -d subprojects/cpr-1.14.2
	test -d subprojects/curl-8.12.1
	test -d subprojects/mINI-0.9.14
	test -d subprojects/spdlog-1.15.0
	test -d subprojects/sqlite-amalgamation-3490100
	test -d subprojects/thrift-0.24.0
	test -d subprojects/tiny-process-library-4bf0e59e64f18d3080a1ce4e853775de2181e993
	dh_auto_configure --buildsystem=meson -- -Darch=x86_64 -Dbuildtype=release

override_dh_auto_install:
	install -d debian/cefbrowser/usr/lib/cefbrowser
	cp -a $(BUILDDIR)/Release/. debian/cefbrowser/usr/lib/cefbrowser/
	install -d debian/cefbrowser/usr/bin
	install -m 0755 debian/cefbrowser.wrapper debian/cefbrowser/usr/bin/cefbrowser

override_dh_strip:
	dh_strip -Xlibcef.so

override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/cefbrowser/usr/lib/cefbrowser
